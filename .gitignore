# ==========================================
# EZY 2 LEARN Driving School - Git Ignore
# ==========================================

# ------------------------------------------
# 1. Next.js & Frontend Node Dependencies
# ------------------------------------------
node_modules/
*/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# ------------------------------------------
# 2. Next.js Build Outputs & Cache
# ------------------------------------------
.next/
*/.next/
frontend/.next/
out/
build/
dist/
.turbo/
.vercel
*.tsbuildinfo
.eslintcache

# ------------------------------------------
# 3. PHP & Backend Vendor / Dependencies
# ------------------------------------------
vendor/
*/vendor/
backend/vendor/
composer.phar

# ------------------------------------------
# 4. Logs, Runtime & Debugging
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/logs/
backend/storage/logs/
backend/storage/cache/
backend/storage/sessions/

# ------------------------------------------
# 5. Environment Variables & Secret Credentials
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env.local
*.env
!*.env.example

# ------------------------------------------
# 6. Uploads & Dynamic Storage
# ------------------------------------------
uploads/
backend/uploads/
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# ------------------------------------------
# 7. Operating System & Editor Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor Configurations
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------
# 8. Temporary & Migration Scratch Scripts
# ------------------------------------------
scratch/
temp/
tmp/
update_reviews_table.php
